# Copy this file to .env and fill in real values. .env is gitignored; this file is not.
# Never put real keys in this file.

# Generation + LLM-as-judge (default provider, Phase 8)
ANTHROPIC_API_KEY=

# Optional: only needed for the OpenAI generator ablation (Phase 8)
OPENAI_API_KEY=

# Observability (Phase 11). Defaults assume the self-hosted docker-compose Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
